# LUPU-FIT configuration. Copy to `.env` (never commit `.env`). Every variable is read only on the server.

# --- Server ---------------------------------------------------------------
NODE_ENV=development
PORT=3000
HOST=0.0.0.0
# Public URL of the app (used in password-reset links and Origin checks)
APP_URL=http://localhost:3000
# Extra origins allowed to send state-changing requests (comma separated). Vite dev server by default.
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Set to true when running behind a reverse proxy / load balancer (X-Forwarded-For)
TRUST_PROXY=false

# --- Database (PostgreSQL 14+) --------------------------------------------
DATABASE_URL=postgres://fitai:fitai_dev_password@127.0.0.1:5432/fitai
DATABASE_POOL_MAX=10
# Run migrations + content seed automatically at startup (default: true outside production)
DB_AUTO_MIGRATE=true

# --- Sessions & security ---------------------------------------------------
# REQUIRED in production: a long random string (>= 32 chars), e.g. `openssl rand -hex 32`
SESSION_SECRET=change-me-to-a-long-random-string
SESSION_TTL_DAYS=30
# Secure cookies (HTTPS only). Defaults to true when NODE_ENV=production.
COOKIE_SECURE=false
MAX_FAILED_LOGINS=5
LOCKOUT_MINUTES=15
RATE_LIMIT_ENABLED=true

# --- AI (Anthropic Claude) -------------------------------------------------
# Without a key the coach runs in built-in mode (data-grounded, no LLM) and meal-photo analysis is disabled.
AI_PROVIDER=anthropic
AI_API_KEY=
AI_MODEL=claude-opus-5-5
# low | medium | high
AI_EFFORT=medium
AI_TIMEOUT_MS=90000
AI_MAX_RETRIES=2
# Server-side refusal fallback (Claude API). Set to false on platforms that do not support it.
AI_REFUSAL_FALLBACK=true
# Optional: custom base URL (proxy/gateway). Leave empty for https://api.anthropic.com
AI_BASE_URL=
COACH_DAILY_MESSAGE_LIMIT=50
PHOTO_ANALYSIS_DAILY_LIMIT=20

# --- Barcode lookup (Open Food Facts, public, no key) ----------------------
OPENFOODFACTS_ENABLED=true
OPENFOODFACTS_BASE_URL=https://world.openfoodfacts.org
OPENFOODFACTS_USER_AGENT=LUPU-FIT/1.0 (contact@example.com)

# --- Phone notifications (Web Push) ----------------------------------------------
# Reminders delivered to phones even when the app is closed (in the Android app, Chrome shows
# them as normal Android notifications). Leave empty to disable: the option is then hidden.
# Generate ONE key pair and keep it: `npx web-push generate-vapid-keys`
# (a new pair silently invalidates every device that already turned notifications on).
# The private key is a secret: keep it out of git and logs.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Contact the push services can use: mailto:you@example.com or an https:// URL
VAPID_SUBJECT=
# Optional: push-service hosts allowed as subscription endpoints (comma separated, subdomains included).
# PUSH_ENDPOINT_HOSTS=fcm.googleapis.com,android.googleapis.com,push.services.mozilla.com,push.apple.com,notify.windows.com
# Optional: how often the reminder job runs (ms, default 60000)
# PUSH_SCHEDULER_INTERVAL_MS=60000

# --- Email (password reset) --------------------------------------------------
# No email provider is bundled. In development, reset links are printed to the server log.
MAIL_FROM=LUPU-FIT <no-reply@example.com>

LOG_REQUESTS=true
