<?xml version="1.0" encoding="utf-8"?>
<!--
  Backup rules for Android 11 and lower (android:fullBackupContent); Android 12+ uses
  data_extraction_rules.xml (keep both in step, the reasons are there).
  requireFlags: every flag of one rule must hold, so each path has two rules: the Google-account copy
  only when it is end-to-end encrypted (Android 9+), and phone-to-phone transfer.
-->
<full-backup-content>
    <include domain="root" path="app_webview/Default/IndexedDB/" requireFlags="clientSideEncryption" />
    <include domain="root" path="app_webview/Default/IndexedDB/" requireFlags="deviceToDeviceTransfer" />
    <include domain="root" path="app_webview/Default/Local Storage/" requireFlags="clientSideEncryption" />
    <include domain="root" path="app_webview/Default/Local Storage/" requireFlags="deviceToDeviceTransfer" />
    <include domain="root" path="app_webview/IndexedDB/" requireFlags="clientSideEncryption" />
    <include domain="root" path="app_webview/IndexedDB/" requireFlags="deviceToDeviceTransfer" />
    <include domain="root" path="app_webview/Local Storage/" requireFlags="clientSideEncryption" />
    <include domain="root" path="app_webview/Local Storage/" requireFlags="deviceToDeviceTransfer" />
</full-backup-content>
