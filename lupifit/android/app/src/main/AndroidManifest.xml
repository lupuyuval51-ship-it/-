<?xml version="1.0" encoding="utf-8"?>
<!--
  LUPU-FIT for Android (device mode): the web app and its server run inside the app (Capacitor WebView
  + PGlite in IndexedDB). No server, no account, no data leaves the phone except the barcode lookup.

  Permissions in the final (merged) manifest, and why (android/build-release.sh prints them):
  - INTERNET: barcode lookup on Open Food Facts (only the barcode is sent). Everything else works offline.
  - POST_NOTIFICATIONS (local-notifications plugin): workout and meal reminders. Android 13+ asks only when
    the person taps "Allow notifications" in Settings > Reminders.
  - RECEIVE_BOOT_COMPLETED, WAKE_LOCK (local-notifications plugin): scheduled reminders survive a restart.
  - SCHEDULE_EXACT_ALARM is removed below: reminders use inexact alarms (a few minutes late is fine), so the
    app never needs the "Alarms & reminders" special access. USE_EXACT_ALARM is never declared.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" tools:node="remove" />
    <uses-permission android:name="android.permission.USE_EXACT_ALARM" tools:node="remove" />

    <!--
      Backup: Android's own backup (Google account backup, and phone-to-phone transfer) includes only the
      app's data: the WebView's IndexedDB (the PGlite database) and its localStorage (app settings), see
      xml/data_extraction_rules.xml (Android 12+) and xml/backup_rules.xml (Android 11 and lower).
    -->
    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">

        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation|density"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:screenOrientation="portrait"
            android:windowSoftInputMode="adjustResize"
            android:exported="true"
            tools:ignore="DiscouragedApi,LockedOrientationActivity">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

        </activity>

        <!-- Share sheet for backup files written to the app's cache folder (@capacitor/share). -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>
</manifest>
