{
  "name": "lupifit",
  "version": "1.0.0",
  "private": true,
  "description": "LUPU-FIT — AI-powered fitness and nutrition application (React + TypeScript, Node.js, PostgreSQL)",
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:server": "tsx watch --clear-screen=false server/src/index.ts",
    "dev:client": "vite --config client/vite.config.ts",
    "build": "npm run build:client && npm run build:server",
    "build:client": "vite build --config client/vite.config.ts && node scripts/build-sw-assets.mjs",
    "build:device": "vite build --config client/vite.config.ts --mode device && node scripts/build-sw-assets.mjs dist/device",
    "build:server": "node scripts/build-server.mjs",
    "android:release": "bash android/build-release.sh",
    "legal:static": "tsx scripts/legal-static.mjs",
    "start": "node dist/server/index.js",
    "db:migrate": "tsx server/src/db/cli.ts migrate",
    "db:seed": "tsx server/src/db/cli.ts seed",
    "db:setup": "tsx server/src/db/cli.ts setup",
    "db:status": "tsx server/src/db/cli.ts status",
    "typecheck": "tsc -p server/tsconfig.json --noEmit && tsc -p client/tsconfig.json --noEmit",
    "lint": "node scripts/lint.mjs && node scripts/design-lint.mjs && node scripts/e2e-strings.mjs",
    "validate:content": "tsx scripts/validate-content.ts",
    "docs:dishes": "tsx scripts/dishes-doc.ts",
    "animation:qa": "tsx scripts/animation-qa.ts",
    "test": "npm run test:server && npm run test:client",
    "test:server": "vitest run --config server/vitest.config.ts",
    "test:server:device": "vitest run --config server/vitest.device.config.ts",
    "test:client": "vitest run --config client/vitest.config.ts",
    "test:e2e": "playwright test --config e2e/playwright.config.ts",
    "test:e2e:device": "playwright test --config e2e/playwright.device.config.ts",
    "verify": "npm run typecheck && npm run lint && npm run validate:content && npm run animation:qa && npm test && npm run test:server:device && npm run build"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.133.0",
    "@electric-sql/pglite": "0.5.13",
    "@fontsource-variable/heebo": "^5.3.0",
    "@fontsource/barlow-condensed": "^5.3.0",
    "@noble/hashes": "2.4.0",
    "@tanstack/react-query": "^5.90.0",
    "express": "^5.1.0",
    "helmet": "^8.1.0",
    "pg": "^8.16.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-router": "^7.9.0",
    "web-push": "^3.6.7",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@capacitor/android": "8.5.3",
    "@capacitor/app": "8.1.2",
    "@capacitor/cli": "8.5.3",
    "@capacitor/core": "8.5.3",
    "@capacitor/filesystem": "8.1.5",
    "@capacitor/local-notifications": "8.3.1",
    "@capacitor/share": "8.0.3",
    "@playwright/test": "1.63.0",
    "@testing-library/react": "^16.3.0",
    "@types/express": "^5.0.3",
    "@types/node": "^22.18.0",
    "@types/pg": "^8.15.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@types/web-push": "^3.6.4",
    "@vitejs/plugin-react": "^5.0.0",
    "esbuild": "^0.25.0",
    "jsdom": "^26.1.0",
    "tsx": "^4.20.0",
    "typescript": "~5.9.2",
    "vite": "^7.1.0",
    "vitest": "^3.2.4"
  }
}
