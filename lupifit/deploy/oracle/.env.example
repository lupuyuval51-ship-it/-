# LUPU-FIT on a small VM with Docker Compose (Oracle Cloud Always Free or any Ubuntu/Debian host).
# setup.sh copies this file to `.env` and fills in the empty values. Never commit `.env`: it holds the
# database password and the session secret. Guide (Hebrew): lupifit/docs/deploy-oracle.md
#
# After you edit `.env`, apply it with:   docker compose up -d
# (run it in this folder; add `sudo` in front if you get "permission denied")

# --- Address --------------------------------------------------------------------------------------------
# Host name only, no https:// and no slash. Caddy gets a free HTTPS certificate for it, so it must point
# at this VM from the internet. Without a domain, setup.sh uses the VM's public IP with dashes:
#   203-0-113-10.sslip.io   (203.0.113.10 is a documentation address, yours will differ)
# With your own domain: app.your-domain.com (create an A record to the VM's public IP first).
SITE_ADDRESS=
# The same address with https:// in front. Used for password-reset links and the Origin check.
APP_URL=

# --- Secrets (setup.sh generates both; keep them letters/digits only, they are used inside a URL) ----------
# POSTGRES_PASSWORD only takes effect when the database is created: do not change it afterwards.
POSTGRES_PASSWORD=
SESSION_SECRET=

# --- Android app (Trusted Web Activity), served as /.well-known/assetlinks.json --------------------------------
ANDROID_APP_PACKAGE=com.lupufit.app
# SHA-256 fingerprint of the upload key (public, not a secret): printed by android-twa/build-aab.sh.
# This is the same value as in render.yaml; replace it if you created a different upload keystore.
ANDROID_CERT_SHA256=25:2D:51:18:6C:86:EB:ED:57:D9:CC:34:45:B0:63:AF:4A:A7:34:C1:63:98:10:27:AD:3C:B4:14:9A:7B:83:3B
# Google Play's "App signing key certificate" SHA-256 (Play Console > Test and release > App integrity).
# Fill it in after the first upload to Play, then run `docker compose up -d`.
ANDROID_PLAY_CERT_SHA256=

# --- Optional ------------------------------------------------------------------------------------------------
# Anthropic API key for the AI coach and meal-photo analysis. Empty = the app runs without AI.
AI_API_KEY=
# Contact for the phone-notification services, e.g. mailto:you@example.com. Empty = the app URL.
VAPID_SUBJECT=

# --- Advanced (normally left alone) ------------------------------------------------------------------------------
# Node heap limit in MB (default 384, good for the 1 GB micro shape).
# NODE_HEAP_MB=384
# PostgreSQL shared_buffers (default 64MB; 256MB is comfortable on the Ampere A1 shape).
# PG_SHARED_BUFFERS=64MB
# Image tags (multi-arch: amd64 + arm64). If Docker Hub answers "429 Too Many Requests", use its mirror:
# NODE_IMAGE=mirror.gcr.io/library/node:22.23.4-bookworm-slim
# POSTGRES_IMAGE=mirror.gcr.io/library/postgres:16.15
# CADDY_IMAGE=mirror.gcr.io/library/caddy:2.11
# Host ports Caddy listens on (Let's Encrypt needs 80 and 443; change only for tests).
# CADDY_HTTP_PORT=80
# CADDY_HTTPS_PORT=443
# Set to false only for an HTTP-only local test (secure cookies need HTTPS).
# COOKIE_SECURE=true
