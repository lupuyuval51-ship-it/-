{
  "name": "plot-twist",
  "version": "0.1.0",
  "private": true,
  "description": "PLOT TWIST — turn free time into a personalized real-world adventure.",
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "dev": "vite",
