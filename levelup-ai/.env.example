# Copy to .env.local for local development. Never commit real secrets.
BIT_PAYMENT_PHONE=0526262828
BIT_PAYMENT_URL=
# Set true only after the owner has independently verified the real HTTPS payment URL.
BIT_PAYMENT_URL_VERIFIED=false
BASIC_MONTHLY_PRICE_NIS=9
PLUS_MONTHLY_PRICE_NIS=19
PRO_MONTHLY_PRICE_NIS=39
DEMO_MODE=true
# Reserved for a future PostgreSQL runtime adapter. The active runtime uses SQLite.
DATABASE_URL=
# Claude API. Leave empty to run the offline Demo coach and Demo content generator.
ANTHROPIC_API_KEY=
AI_PROVIDER=anthropic
# Defaults to claude-opus-5. Override only to pin a different Claude model.
AI_MODEL=
# Reasoning depth: low | medium | high | xhigh | max. Unset uses the API default.
AI_EFFORT=
# Daily AI allowance = free quota + (monthly amount paid x per-shekel rate).
AI_FREE_DAILY_MESSAGES=8
AI_MESSAGES_PER_NIS=2.5
AI_FREE_DAILY_GAMES=1
AI_GAMES_PER_NIS=0.3
# Accounts open without a sign-up form, so bulk creation is capped here.
GUEST_HOURLY_LIMIT=500
GUEST_NETWORK_LIMIT=20
APP_URL=http://localhost:3000
# Enable only behind a trusted reverse proxy that overwrites X-Forwarded-For.
TRUST_PROXY=false
# Optional durable SQLite/storage paths; defaults are ./data/levelup.sqlite and ./data/uploads.
LEVELUP_DB_PATH=
LEVELUP_UPLOAD_DIR=
