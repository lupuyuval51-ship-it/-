{
  "name": "lupu-fit",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "shared",
    "server",
    "client"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p shared/tsconfig.json && tsc --noEmit -p scripts/tsconfig.json && tsc --noEmit -p server/tsconfig.json",
    "lint": "node scripts/design-lint.mjs && node scripts/contrast-check.mjs && node scripts/security-scan.mjs && tsx scripts/copy-lock.ts",
    "test:shared": "vitest run --root shared",
    "gates": "npm run typecheck && npm run lint && npm run validate:content && npm run test:shared && npm run test:tools && npm run test:server",
    "test:tools": "vitest run --root scripts",
    "validate:content": "tsx scripts/validate-content.ts",
    "gen:workouts": "tsx scripts/gen-ready-workouts.ts",
    "gen:docs": "tsx scripts/gen-video-docs.ts",
    "gen:videos": "tsx scripts/gen-videos.ts",
    "verify:videos": "tsx scripts/verify-videos.ts",
    "gen:migrations": "tsx scripts/gen-migrations.ts",
    "test:server": "vitest run --root server",
    "dev:client": "vite --config client/vite.config.ts client",
    "dev:server": "tsx --env-file-if-exists=.env server/src/index.ts",
    "build:hosted": "vite build --config client/vite.config.ts --mode hosted client",
    "build:device": "vite build --config client/vite.config.ts --mode device client",
    "build": "npm run gen:migrations && npm run build:hosted && npm run build:device",
    "test:client": "vitest run --root client"
  },
  "devDependencies": {
    "@fontsource-variable/heebo": "^5.3.0",
    "@fontsource/barlow-condensed": "^5.3.0",
    "@napi-rs/canvas": "^1.1.0",
    "@types/node": "^22.20.5",
    "tsx": "^4.23.15",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0",
    "zod": "^4.0.0"
  }
}
