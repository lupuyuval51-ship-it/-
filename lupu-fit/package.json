{
  "name": "lupu-fit",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "shared",
    "server",
    "client"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p shared/tsconfig.json && tsc --noEmit -p scripts/tsconfig.json",
    "lint": "node scripts/design-lint.mjs && node scripts/contrast-check.mjs && node scripts/security-scan.mjs && tsx scripts/copy-lock.ts",
    "test:shared": "vitest run --root shared",
    "gates": "npm run typecheck && npm run lint && npm run test:shared && npm run test:tools",
    "test:tools": "vitest run --root scripts"
  },
  "devDependencies": {
    "@fontsource-variable/heebo": "^5.3.0",
    "@fontsource/barlow-condensed": "^5.3.0",
    "@types/node": "^22.20.5",
    "tsx": "^4.23.15",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0",
    "zod": "^4.0.0"
  }
}
