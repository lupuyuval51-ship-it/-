# AppSpark AI – client configuration (all variables are optional)
# Only EXPO_PUBLIC_* variables are read by the app. Never put secret keys here.

# Supabase project (Project Settings → API). Leave empty to run in local mode:
# everything is stored on the device and no account is required.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Name of the deployed Edge Function that proxies the AI provider (default: ai-generate)
EXPO_PUBLIC_AI_FUNCTION_NAME=ai-generate

# Optional optimistic hint that the server has an AI provider configured ("1" or empty).
# The app still asks the function's health endpoint before showing "connected".
EXPO_PUBLIC_AI_ENABLED=

# --- Server side (Supabase Edge Function secrets, NOT part of the app bundle) ---
# supabase secrets set AI_PROVIDER=anthropic AI_API_KEY=sk-... AI_MODEL=claude-sonnet-5-5 AI_DAILY_LIMIT=40
