/**
 * Generates supabase/seed.sql from the TypeScript catalogue so the same ideas
 * can be mirrored into Postgres. Idempotent upserts.
 *
 * Usage: node --experimental-strip-types --no-warnings scripts/generate-seed-sql.mts
 */
import { readdirSync, writeFileSync } from 'node:fs';
import { join, resolve } from 'node:path';
import { pathToFileURL } from 'node:url';

import { categories } from '../src/data/categories.ts';
import type { Idea } from '../src/data/types.ts';

function sql(value: unknown): string {
  if (value === null || value === undefined) return 'null';
  if (typeof value === 'number' || typeof value === 'boolean') return String(value);
  if (Array.isArray(value)) return `array[${value.map((v) => sql(String(v))).join(', ')}]::text[]`;
  if (typeof value === 'object') return `${sql(JSON.stringify(value))}::jsonb`;
  return `'${String(value).replace(/'/g, "''")}'`;
}

const seedDir = resolve(process.cwd(), 'src/data/seed');
const files = readdirSync(seedDir).filter((f) => f.endsWith('.ts') && f !== 'index.ts');
const ideas: Idea[] = [];
for (const file of files) {
  const mod = await import(pathToFileURL(join(seedDir, file)).href);
  ideas.push(...(mod.ideas as Idea[]));
}

const lines: string[] = ['-- Generated by scripts/generate-seed-sql.mts. Do not edit by hand.', 'begin;', ''];
categories.forEach((category, index) => {
  lines.push(
    `insert into public.categories (slug, label, description, glyph, hue, sort_order) values (${sql(category.slug)}, ${sql(category.label)}, ${sql(category.description)}, ${sql(category.glyph)}, ${category.hue}, ${index})` +
      ' on conflict (slug) do update set label = excluded.label, description = excluded.description, glyph = excluded.glyph, hue = excluded.hue, sort_order = excluded.sort_order;',
  );
});
lines.push('');
for (const idea of ideas) {
  lines.push(
    'insert into public.ideas (id, category, secondary_categories, name, tagline, difficulty, effort_weeks_min, effort_weeks_max, budget, business_model, platforms, audience, tags, identity, flags, spec) values (' +
      [
        sql(idea.id),
        sql(idea.category),
        sql(idea.secondaryCategories),
        sql(idea.name),
        sql(idea.tagline),
        sql(idea.difficulty),
        idea.effort.weeksMin,
        idea.effort.weeksMax,
        sql(idea.budget),
        sql(idea.businessModel),
        sql(idea.platforms),
        sql(idea.audience),
        sql(idea.tags),
        sql(idea.identity),
        sql(idea.flags),
        sql(idea.spec),
      ].join(', ') +
      ') on conflict (id) do update set category = excluded.category, secondary_categories = excluded.secondary_categories, name = excluded.name, tagline = excluded.tagline, difficulty = excluded.difficulty, effort_weeks_min = excluded.effort_weeks_min, effort_weeks_max = excluded.effort_weeks_max, budget = excluded.budget, business_model = excluded.business_model, platforms = excluded.platforms, audience = excluded.audience, tags = excluded.tags, identity = excluded.identity, flags = excluded.flags, spec = excluded.spec, updated_at = now();',
  );
}
lines.push('', 'commit;', '');
const out = resolve(process.cwd(), 'supabase/seed.sql');
writeFileSync(out, lines.join('\n'));
console.log(`Wrote ${ideas.length} ideas and ${categories.length} categories to ${out}`);
