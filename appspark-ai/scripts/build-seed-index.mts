/**
 * Generates src/data/seed/index.ts from the seed files that exist on disk.
 * Usage: node --experimental-strip-types --no-warnings scripts/build-seed-index.mts
 */
import { readdirSync, writeFileSync } from 'node:fs';
import { resolve } from 'node:path';

const seedDir = resolve(process.cwd(), 'src/data/seed');
const files = readdirSync(seedDir)
  .filter((f) => f.endsWith('.ts') && f !== 'index.ts')
  .map((f) => f.replace(/\.ts$/, ''))
  .sort();

const lines: string[] = ['// Generated by scripts/build-seed-index.mts – do not edit by hand.', "import type { Idea } from '../types';", ''];
for (const f of files) lines.push(`import { ideas as ${f.replace(/-/g, '_')} } from './${f}';`);
lines.push('', 'export const seedIdeas: Idea[] = [', ...files.map((f) => `  ...${f.replace(/-/g, '_')},`), '];', '');
writeFileSync(resolve(seedDir, 'index.ts'), lines.join('\n'));
console.log(`Seed index written with ${files.length} file(s): ${files.join(', ')}`);
