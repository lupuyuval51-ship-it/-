<?xml version="1.0" encoding="utf-8"?>
<!-- Only what Capacitor's file chooser can ever share (photos it creates in the app's own folders). The app has no camera
     input today; the broad external-storage root that the Capacitor template declared is gone on purpose. -->
<paths xmlns:android="http://schemas.android.com/apk/res/android">
    <external-files-path name="capacitor_pictures" path="Pictures/" />
    <cache-path name="capacitor_cache" path="." />
</paths>
