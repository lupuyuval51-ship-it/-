<?xml version="1.0" encoding="utf-8"?>
<!--
  Nothing is copied off the phone by Android: not by cloud backup (Google Drive) and not by device-to-device transfer.
  The games and the optional sign-in session live in the WebView's local storage; the only copy that leaves the phone is the
  user's own opt-in, owner-only Supabase backup (account in Settings). allowBackup="false" in the manifest already turns
  backup off; on Android 12+ some manufacturers still run device-to-device transfer, so it is excluded explicitly too
  (https://developer.android.com/identity/data/autobackup).
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </device-transfer>
</data-extraction-rules>
