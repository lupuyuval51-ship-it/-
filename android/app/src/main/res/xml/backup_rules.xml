<?xml version="1.0" encoding="utf-8"?>
<!--
  Android 11 and older (data_extraction_rules.xml is read on Android 12+): nothing is copied by Auto Backup. allowBackup="false"
  in the manifest already turns backup off; this file only repeats it so the two rule sets agree (and lint is satisfied).
-->
<full-backup-content>
    <exclude domain="root" path="." />
    <exclude domain="file" path="." />
    <exclude domain="database" path="." />
    <exclude domain="sharedpref" path="." />
    <exclude domain="external" path="." />
</full-backup-content>
