<?xml version="1.0" encoding="utf-8"?>
<!--
  Resource shrinking (shrinkResources in app/build.gradle) removes resources it cannot see being used. Capacitor/Cordova look
  some up by NAME at runtime (res/xml/config.xml is generated by `npx cap sync` and read by the Cordova bridge), so they are
  listed here. https://developer.android.com/build/shrink-code#keep-resources
-->
<resources xmlns:tools="http://schemas.android.com/tools"
    tools:keep="@xml/config,@xml/file_paths,@string/app_name,@string/title_activity_main,@string/package_name,@string/custom_url_scheme,@drawable/splash*"
    tools:shrinkMode="safe" />
