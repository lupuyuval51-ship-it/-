<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
      Permissions. INTERNET: only for the optional account (Supabase over HTTPS); the app makes no request while signed out.
      VIBRATE comes from @capacitor/haptics (the vibration setting) and is merged in by Gradle. Nothing else is requested:
      no storage, camera, microphone, location, contacts or notifications. Check with the merged manifest after every
      plugin update (app/build/intermediates/merged_manifests/release/.../AndroidManifest.xml).
    -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!--
      allowBackup="true": the learner's games, progress, settings and plan live in the WebView's local storage. Android's own backup
      (Auto Backup to the user's Google account, and device-to-device transfer) keeps them, so the learner's data survives a
      reinstall and moves to a new phone without any account. The rules are in data_extraction_rules.xml (Android 12+) and
      backup_rules.xml (older); only caches are left out. A Supabase sign-in session, if the learner chose one, is part of it.
      See docs/play-release.md.
      usesCleartextTraffic="false": HTTPS only (the only server is the Supabase project in the CSP).
    -->
    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:usesCleartextTraffic="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">

        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize"
            android:exported="true">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!--
              Return address of "Continue with Google" (optional account): Supabase redirects the system browser to
              app.levelup.learn3d://auth?code=... and Android hands it to this activity (singleTask, so the running app is reused;
              Capacitor's App plugin reports it as appUrlOpen). Only that scheme + host is claimed. The one-time code is useless
              without the PKCE verifier kept inside this app, so another app that declares the same scheme gains nothing.
            -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="app.levelup.learn3d" android:host="auth" />
            </intent-filter>

        </activity>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths"></meta-data>
        </provider>
    </application>
</manifest>
