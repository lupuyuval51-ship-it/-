# ───────── LUPU Study AI – משתני סביבה (ללא סודות!) ─────────
# העתק לקובץ .env.local ומלא ערכים. אל תעלה .env.local ל-Git.

# --- Supabase (אימות, מסד נתונים, אחסון קבצים) ---
# כתובת הפרויקט ומפתח ה-anon הציבורי (מותר בדפדפן; ההגנה מתבצעת על ידי RLS)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Anthropic (מורה AI) – בצד השרת בלבד! אסור להוסיף NEXT_PUBLIC_ ---
ANTHROPIC_API_KEY=
# מודל ברירת מחדל. ניתן להחליף ללא שינוי קוד.
ANTHROPIC_MODEL=claude-sonnet-5-5
# אופציונלי: כתובת בסיס חלופית (למשל gateway ארגוני). ברירת מחדל: https://api.anthropic.com
# ANTHROPIC_BASE_URL=

# --- הגבלת קצב ועלויות AI ---
AI_RATE_LIMIT_PER_MINUTE=12
AI_RATE_LIMIT_PER_DAY=150
AI_GUEST_RATE_LIMIT_PER_DAY=15
AI_MAX_OUTPUT_TOKENS=1800
