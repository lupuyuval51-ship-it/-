# ---- Claude (server-side only; never exposed to the browser) ----
ANTHROPIC_API_KEY=
# Model is configurable without code changes. Leave empty to use the built-in default.
CLAUDE_MODEL=claude-opus-5
# Reasoning effort for coach calls: low | medium | high
CLAUDE_EFFORT=medium
# Hard cap on output tokens per call (cost protection)
CLAUDE_MAX_OUTPUT_TOKENS=6000

# ---- Database ----
# PostgreSQL / Supabase connection string. When empty, DiscCoach runs an embedded
# PostgreSQL (PGlite) stored under PGLITE_DATA_DIR – ideal for local development.
DATABASE_URL=
PGLITE_DATA_DIR=./data/pglite

# ---- Auth ----
# Long random string used to sign session cookies.
SESSION_SECRET=change-me-to-a-long-random-string
# Comma-separated emails that receive the admin role when they register.
ADMIN_EMAILS=

# ---- App ----
APP_URL=http://localhost:3000
PORT=3000

# ---- AI cost protection (transparent to users; never a paywall) ----
AI_RATE_LIMIT_PER_HOUR=40
AI_RATE_LIMIT_PER_DAY=150
AI_CACHE_TTL_HOURS=24
AI_REQUEST_TIMEOUT_MS=90000
