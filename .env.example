# ─────────────────────────────────────────────────────────────────────────────
# LEVEL UP — environment variables. Copy to `.env` and fill in. NEVER commit `.env`.
# Everything here is server-side only. Nothing is exposed to the browser: there are
# deliberately no NEXT_PUBLIC_* secrets.
# ─────────────────────────────────────────────────────────────────────────────

# Runtime environment label: local | test | production
APP_ENV=local
# Public base URL of the app (used for Stripe redirect URLs and CSRF origin checks).
APP_URL=http://localhost:3000

# ── Database (PostgreSQL 14+) ────────────────────────────────────────────────
DATABASE_URL=postgresql://levelup:levelup@127.0.0.1:54329/levelup

# ── Sessions ─────────────────────────────────────────────────────────────────
# Login sessions are random 256-bit tokens; only their SHA-256 is stored (in the database), so there is
# no signing secret to configure.

# Set to `true` ONLY when the app runs behind a reverse proxy you control that overwrites
# X-Forwarded-For (Vercel, Cloudflare, nginx...). Otherwise client IPs for rate limiting are not trusted.
TRUST_PROXY=false
# How many proxies sit in front of the app (Cloudflare + nginx = 2). The client IP is the X-Forwarded-For entry this many places
# from the RIGHT, because every proxy appends the address it saw and the left end is whatever the client claimed.
TRUSTED_PROXY_HOPS=1
# Secret behind the opaque answer ids players see. Optional: without it a value derived from DATABASE_URL is used.
ANSWER_SEED_SECRET=

# ── AI game generation ───────────────────────────────────────────────────────
# auto      → use a real provider when its key below is set, otherwise no AI (topic library and the learner's own material only)
# anthropic → Anthropic Messages API       (requires ANTHROPIC_API_KEY)
# openai    → any OpenAI-compatible API    (requires OPENAI_API_KEY; optionally OPENAI_BASE_URL)
# none      → no AI                        (topic library and the learner's own material only)
AI_PROVIDER=auto
ANTHROPIC_API_KEY=
# Model id. Any current Claude model works (e.g. claude-sonnet-5-5 is cheaper, claude-opus-5-5 is the default).
ANTHROPIC_MODEL=claude-opus-5-5
# Ask the API to re-run a request on a fallback model if the primary model declines it (server-side-fallback beta).
# Automatically retried without it if your account/API version rejects the parameter.
ANTHROPIC_REFUSAL_FALLBACK=true
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4.1
# Example: DeepSeek's hosted API (OpenAI-compatible). Set these in the SERVER environment only, never in the client or the repo:
#   AI_PROVIDER=openai
#   OPENAI_BASE_URL=https://api.deepseek.com
#   OPENAI_MODEL=<model id your DeepSeek account lists, see GET https://api.deepseek.com/models>
# Check the output quality with a real generation and edit before relying on it: every result still has to pass validateGameSpec.
# Hard per-provider-call timeout and whole-job deadline, in milliseconds.
AI_CALL_TIMEOUT_MS=240000
AI_JOB_DEADLINE_MS=600000

# ── Plans ────────────────────────────────────────────────────────────────────
# false (default) → no plans anywhere: no pricing page, no plan names, checkout is unavailable; everybody gets the full product.
# true            → Free / Plus / Pro, pricing and checkout (see Payments below).
PLANS_ENABLED=false
# With plans off, still show the plans and prices (pricing page, landing, nav) as information, with no way to buy.
PLANS_SHOWN=true

# ── Display switch (it never unlocks anything) ─────────────────────────────
# true → the game page shows the editing tools (rename, time of day, mechanics, AI edits, version history). The API stays either way.
GAME_EDITING=false

# ── Payments ─────────────────────────────────────────────────────────────────
# disabled → checkout is unavailable (default)
# stripe   → real recurring billing (needs the Stripe variables below)
# dev      → LOCAL SIMULATOR for development/testing. Refused when APP_ENV=production.
PAYMENTS_MODE=disabled
# Prices are NOT configured in Stripe: checkout sends the amount and currency from src/config/plans.ts
# (Plus $5 or exactly ₪5 for Israel, Pro $20 or exactly ₪20 for Israel). You only need the API key and the webhook signing secret.
STRIPE_SECRET_KEY=
# Signing secret (whsec_...) of the webhook endpoint <APP_URL>/api/webhooks/stripe — see README → Payments.
STRIPE_WEBHOOK_SECRET=

# ── Sign in with Google (optional) ───────────────────────────────────────────
# OAuth client of type "Web application" from Google Cloud Console; set BOTH or neither (without both, the
# button and /api/auth/google/* do not exist). Authorised redirect URI: <APP_URL>/api/auth/google/callback.
# Step by step: docs/google-signin.md. The secret stays on the server.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── Operations ───────────────────────────────────────────────────────────────
# Shared secret for POST /api/internal/reap (optional cron that releases stuck generation jobs).
CRON_SECRET=
# Enables window.__LEVELUP_TEST__ helpers in the play screen. For automated browser tests ONLY.
# Refused when APP_ENV=production.
ENABLE_TEST_HOOKS=false
