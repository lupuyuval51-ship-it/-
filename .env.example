# ─────────────────────────────────────────────────────────────────────────────
# LEVEL UP — environment variables. Copy to `.env` and fill in. NEVER commit `.env`.
# Everything here is server-side only. Nothing is exposed to the browser: there are
# deliberately no NEXT_PUBLIC_* secrets.
# ─────────────────────────────────────────────────────────────────────────────

# Runtime environment label: local | test | production
APP_ENV=local
# Public base URL of the app (used for Stripe redirect URLs and CSRF origin checks).
APP_URL=http://localhost:3000

# ── Database (PostgreSQL 14+) ────────────────────────────────────────────────
DATABASE_URL=postgresql://levelup:levelup@127.0.0.1:54329/levelup

# ── Sessions / signing ───────────────────────────────────────────────────────
# 32+ random bytes, e.g. `openssl rand -base64 48`. Signs play-session tokens.
SESSION_SECRET=replace-with-a-long-random-string-at-least-32-chars

# Set to `true` ONLY when the app runs behind a reverse proxy you control that overwrites
# X-Forwarded-For (Vercel, Cloudflare, nginx...). Otherwise client IPs for rate limiting are not trusted.
TRUST_PROXY=false

# ── AI game generation ───────────────────────────────────────────────────────
# auto      → use a real provider when its key below is set, otherwise the labelled DEMO provider
# anthropic → Anthropic Messages API       (requires ANTHROPIC_API_KEY)
# openai    → any OpenAI-compatible API    (requires OPENAI_API_KEY; optionally OPENAI_BASE_URL)
# demo      → predefined local templates   (never presented as AI-generated)
AI_PROVIDER=auto
ANTHROPIC_API_KEY=
# Model id. Any current Claude model works (e.g. claude-sonnet-5-5 is cheaper, claude-opus-5-5 is the default).
ANTHROPIC_MODEL=claude-opus-5-5
# Ask the API to re-run a request on a fallback model if the primary model declines it (server-side-fallback beta).
# Automatically retried without it if your account/API version rejects the parameter.
ANTHROPIC_REFUSAL_FALLBACK=true
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4.1
# Hard per-provider-call timeout and whole-job deadline, in milliseconds.
AI_CALL_TIMEOUT_MS=240000
AI_JOB_DEADLINE_MS=600000

# ── Payments ─────────────────────────────────────────────────────────────────
# disabled → checkout is unavailable (default)
# stripe   → real recurring billing (needs the Stripe variables below)
# dev      → LOCAL SIMULATOR for development/testing. Refused when APP_ENV=production.
PAYMENTS_MODE=disabled
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Price ids from `npm run stripe:setup` (or create them by hand, see README → Payments)
STRIPE_PRICE_PLUS=
STRIPE_PRICE_PRO=

# ── Operations ───────────────────────────────────────────────────────────────
# Shared secret for POST /api/internal/reap (optional cron that releases stuck generation jobs).
CRON_SECRET=
# Enables window.__LEVELUP_TEST__ helpers in the play screen. For automated browser tests ONLY.
# Refused when APP_ENV=production.
ENABLE_TEST_HOOKS=false
