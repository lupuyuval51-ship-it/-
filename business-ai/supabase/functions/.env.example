# Edge Function secrets/config for the `ai` and `advisor` functions.
# Production: set with `supabase secrets set ANTHROPIC_API_KEY=sk-ant-...` (never commit real keys).
# Local: copy to supabase/functions/.env (git-ignored) and run `supabase functions serve --env-file supabase/functions/.env`.
# SUPABASE_URL / SUPABASE_ANON_KEY / SUPABASE_SERVICE_ROLE_KEY are injected by Supabase automatically.

# Required. Missing → every AI request answers 503 `not_configured`.
ANTHROPIC_API_KEY=

# Optional (defaults shown).
AI_MODEL=claude-opus-5-5
# Only override for tests (fake server), e.g. http://host.docker.internal:8787 from the edge-runtime container.
AI_API_BASE_URL=https://api.anthropic.com
AI_MAX_RETRIES=2
AI_TIMEOUT_MS=120000

# Optional: comma-separated list of allowed browser origins. Empty = any origin (bearer-token API, no cookies).
CORS_ALLOWED_ORIGINS=
