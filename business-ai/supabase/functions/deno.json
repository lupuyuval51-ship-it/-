{
  "imports": {
    "zod": "npm:zod@4.6.7",
    "@supabase/supabase-js": "npm:@supabase/supabase-js@2.119.0",
    "@anthropic-ai/sdk": "npm:@anthropic-ai/sdk@1.4.0"
  },
  "compilerOptions": {
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noFallthroughCasesInSwitch": true
  },
  "test": {
    "include": ["tests/"],
    "exclude": ["_shared/domain/", "../tests/", "../../e2e/", "../../src/"]
  },
  "fmt": {
    "lineWidth": 120,
    "singleQuote": true,
    "exclude": ["_shared/database.types.ts", "_shared/domain/"]
  },
  "lint": {
    "exclude": ["_shared/database.types.ts"]
  },
  "tasks": {
    "check": "deno check ai/index.ts advisor/index.ts tests/",
    "test": "deno test --allow-env --allow-net --allow-read --allow-run=supabase",
    "fake-anthropic": "node ../../e2e/fake-anthropic/server.mjs"
  }
}
