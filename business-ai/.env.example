# BUSINESS AI — public app configuration (copied into the app bundle at build time).
# Copy to `.env` (gitignored) and fill in. Only EXPO_PUBLIC_* values reach the app;
# never put service-role keys or the Anthropic key here (those live in Edge Function secrets).

# Supabase API URL.
#   Local stack:  run `supabase status -o json` in business-ai/ → "API_URL"  (http://127.0.0.1:54321)
#   Android emulator: use http://10.0.2.2:54321 ; physical device: your machine's LAN IP.
#   Hosted:       https://<project-ref>.supabase.co
EXPO_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321

# Supabase anon (public) key — safe to ship; RLS protects every table.
#   Local stack:  `supabase status -o json` → "ANON_KEY" (or the "PUBLISHABLE_KEY" sb_publishable_… key)
#   Hosted:       Project Settings → API → anon / publishable key
EXPO_PUBLIC_SUPABASE_ANON_KEY=
