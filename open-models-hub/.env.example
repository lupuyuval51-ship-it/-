PORT=3100

# OPEN has no usage limits by default. Each of these is opt-in; 0 / empty = unlimited.
RATE_LIMIT_PER_MIN=0
MAX_STREAMS_PER_IP=0
STREAM_TIMEOUT_SECONDS=0
# Memory protection for request bodies (not a usage cap)
BODY_LIMIT_MB=32
# Protects the chat API when you deploy publicly (otherwise anyone can spend your provider keys).
# Requests that carry their own provider key (BYO key) are not affected.
HUB_ACCESS_CODE=

# Add any providers you want. One key (OpenRouter) already covers almost every open model.
OPENROUTER_API_KEY=
TOGETHER_API_KEY=
DEEPINFRA_API_KEY=
GROQ_API_KEY=
FIREWORKS_API_KEY=
HF_TOKEN=

# Local inference (no key needed)
OLLAMA_BASE_URL=http://localhost:11434/v1
# Any OpenAI-compatible server: vLLM, LM Studio, llama.cpp server, SGLang, TGI ...
CUSTOM_BASE_URL=
CUSTOM_API_KEY=
CUSTOM_NAME=vLLM / LM Studio

# Set to true only when running behind a trusted reverse proxy (uses X-Forwarded-For for rate limits)
TRUST_PROXY=false
# How often the live catalog is refreshed (minutes)
CATALOG_REFRESH_MINUTES=360
